#!/bin/sh
# Testy przed kazdym commitem. Co dokladnie sie odpala, wie wylacznie Makefile —
# hook, CI i `make test` maja jedno zrodlo prawdy i nie moga sie rozejsc.
#
# Wlaczenie hookow po sklonowaniu repo:
#     make hooks
#
# Testy ida po drzewie roboczym, nie po indeksie: przy czesciowo dodanych
# zmianach sprawdzasz to, co masz w edytorze.
set -e
cd "$(git rev-parse --show-toplevel)"
make test
